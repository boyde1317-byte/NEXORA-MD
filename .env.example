# ═══════════════════════════════════════════════════════════════════════
#  NEXORA MD — Environment Configuration
#  Copy this file to .env and fill in your values: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── REQUIRED: Bot Owner Configuration ─────────────────────────────────────
# Comma-separated phone numbers without + or @s.whatsapp.net
# Example: "447911123456" or "233597514499,233533416608"
OWNER_NUMBERS="YOUR_PHONE_NUMBER"

# Owner display name (shown in credits, about, etc.)
OWNER_NAME="Aizen"

# Default pairing phone number (must include country code, no + or spaces)
# Must be one of the numbers listed in OWNER_NUMBERS
PAIRING_PHONE="YOUR_PHONE_NUMBER"

# ── OPTIONAL: AI Integration ──────────────────────────────────────────────
# Google Gemini API key — enables AI image generation and asset creation
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Set to "true" to generate AI assets on first startup (requires GEMINI_API_KEY)
GENERATE_ASSETS=false

# ── OPTIONAL: Web API Keys ───────────────────────────────────────────────
NEWS_API_KEY=""
SMMRY_API_KEY=""
OMDB_API_KEY=""

# ── OPTIONAL: WhatsApp Channel ────────────────────────────────────────────
# Channel JID for the newsletter menu type
CHANNEL_JID=""

# ── OPTIONAL: Server Configuration ───────────────────────────────────────
# Web server port (auto-set on Railway/Render/Replit)
PORT=3000

# Set to "production" for optimized module caching
NODE_ENV=production
